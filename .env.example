MOMENTUM_MIN_BUY_RATIO="0.60"
MOMENTUM_MIN_UNIQUE_BUYERS="3"
MOMENTUM_MIN_ACCELERATION="0.5"
MOMENTUM_MAX_TRADE_AGE_SECONDS="120"

# ================= PERFIS =================
ENTRY_PROFILE_MODE="auto"
HOLDERS_CACHE_SECONDS="30"
FIRST_PUMP_ENABLED="true"
FIRST_PUMP_MAX_TOKEN_AGE_SECONDS="30"
FIRST_PUMP_MIN_MARKET_CAP_SOL="0"
FIRST_PUMP_MAX_MARKET_CAP_SOL="4"
FIRST_PUMP_MIN_VOLUME_SOL="0"
FIRST_PUMP_MAX_VOLUME_SOL="5"
