MOMENTUM_PROFILE_MAX_TOKEN_AGE_SECONDS="0"
MOMENTUM_PROFILE_MIN_MARKET_CAP_SOL="0"
MOMENTUM_PROFILE_MAX_MARKET_CAP_SOL="0"
MOMENTUM_PROFILE_MIN_VOLUME_SOL="0"
MOMENTUM_PROFILE_MAX_VOLUME_SOL="0"
MOMENTUM_PROFILE_MIN_HOLDERS="0"
