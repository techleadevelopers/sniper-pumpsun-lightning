# ================= MODO =================
SIMULATION="true"
ENABLE_LIVE_TRADING="false"

# ================= PUMPPORTAL LIGHTNING =================
PUMPPORTAL_API_KEY="sua-chave-aqui"
PUMPPORTAL_URL="https://pumpportal.fun/api/trade"
PUMPPORTAL_WS="wss://pumpportal.fun/api/data"
WALLET_PUBLIC_ADDRESS="carteira-vinculada-a-chave"

# ================= BASE DE DADOS =================
SIMULATION_DATABASE_URL="postgres://sniper:senha@localhost:5432/sniper_paper"
REAL_DATABASE_URL="postgres://sniper:senha@localhost:5432/sniper_live"
ADMIN_PASSWORD="senha-admin"

# ================= TRADING =================
TRADE_USD="1"
MAX_TRADE_SOL="0.05"
MAX_EXPOSURE_SOL="0.5"
MAX_DAILY_LOSS_SOL="0.15"
FEE_RESERVE_SOL="0.01"
MAX_OPEN_POSITIONS="10"
MAX_SLIPPAGE_BPS="1500"
MAX_PRIORITY_FEE_SOL="0.001"
TAKE_PROFIT_GROSS_PCT="80"
STOP_LOSS_PCT="20"
TRAILING_STOP_PCT="15"
TRAILING_STOP_ARM_PCT="10"
MAX_HOLD_SECONDS="1200"

# ================= SCANNER =================
TOKEN_QUEUE_SIZE="5000"
ENTRY_DELAY_SECONDS="1"
SNIPE_CONCURRENCY="4"
SNIPE_TIMEOUT_MS="15000"
DEDUPE_TTL_MS="60000"
TOKEN_MAX_AGE_SECONDS="60"
PRICE_POLL_SECONDS="20"
RPC_HEALTH_CHECK_INTERVAL_SECONDS="45"

# ================= FILTROS GLOBAIS =================
MIN_MARKET_CAP_SOL="0"
MAX_MARKET_CAP_SOL="0"
MIN_VOLUME_BEFORE_BUY="0"
MAX_VOLUME_BEFORE_BUY="100000"

# ================= MOMENTUM =================
MOMENTUM_ENABLED="true"
MOMENTUM_SHORT_WINDOW_SECONDS="10"
MOMENTUM_MEDIUM_WINDOW_SECONDS="30"
MOMENTUM_LONG_WINDOW_SECONDS="60"
